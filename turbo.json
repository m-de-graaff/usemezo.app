{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [".env"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"start": {
			"cache": false,
			"persistent": true
		},
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"outputs": []
		},
		"test": {
			"outputs": []
		}
	},
	"globalPassThroughEnv": [
		"CI",
		"NODE_ENV",
		"SKIP_ENV_VALIDATION",
		"VERCEL*",
		"DATABASE_URL",
		"BETTER_AUTH*",
		"RESEND*",
		"SMTP*",
		"EMAIL*"
	]
}
