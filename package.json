{
	"name": "usemezo",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.10.0",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"start": "turbo run start",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"check": "biome check .",
		"check:write": "biome check --write .",
		"check:unsafe": "biome check --write --unsafe .",
		"db:generate": "pnpm -F @mezo/db generate",
		"db:migrate": "pnpm -F @mezo/db migrate",
		"db:push": "pnpm -F @mezo/db push",
		"db:studio": "pnpm -F @mezo/db studio"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@types/node": "^26.2.0",
		"turbo": "^2.10.11",
		"typescript": "^7.0.2"
	}
}
