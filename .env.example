# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in
# "packages/env/src/index.ts" should be updated accordingly.

# Better Auth
# Secret used by Better Auth
BETTER_AUTH_SECRET=""

# Public URL Better Auth builds OAuth callbacks from
BETTER_AUTH_URL="http://localhost:3050"

# Better Auth Google OAuth
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
BETTER_AUTH_GOOGLE_CLIENT_ID=""
BETTER_AUTH_GOOGLE_CLIENT_SECRET=""

# Better Auth Apple OAuth
# The "client secret" is a short-lived JWT signed with the .p8 private key from
# the Apple developer portal; regenerate it before it expires (max 6 months).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/apple
BETTER_AUTH_APPLE_CLIENT_ID=""
BETTER_AUTH_APPLE_CLIENT_SECRET=""

# Stripe
# Both blank keeps the billing plugin switched off entirely.
# Webhook endpoint: <BETTER_AUTH_URL>/api/auth/stripe/webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email
# Leave RESEND_API_KEY empty in development: mail then goes to SMTP_URL, which
# expects a local Mailpit (docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit).
# Inbox: http://localhost:8025
RESEND_API_KEY=""
SMTP_URL="smtp://localhost:1025"
EMAIL_FROM="Mezo <onboarding@resend.dev>"

# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5432/usemezo.app"

# Anthropic
# What Milo (the assistant at /milo) talks to. One key covers every model;
# swap the model id in apps/nextjs/src/app/api/chat/route.ts to change model.
# Keys: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
